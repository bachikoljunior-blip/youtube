# ---------------------------------------------------------------------------
# ローカル実行用。GitHub Actions では同じ名前で Repository secrets に登録する。
# 本番の値を .env に入れてもコミットされない（.gitignore 済み）
# ---------------------------------------------------------------------------

# 1) 台本生成（Anthropic Console で発行）
ANTHROPIC_API_KEY=sk-ant-...

# 2) YouTube アップロード（Google Cloud OAuth クライアント）
#    scripts/get_refresh_token.py を一度だけ実行して REFRESH_TOKEN を得る
YT_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
YT_CLIENT_SECRET=GOCSPX-...
YT_REFRESH_TOKEN=1//0e...

# 3) 音声合成（Google Cloud Text-to-Speech / 同じ GCP プロジェクトの API キー）
GOOGLE_TTS_API_KEY=AIza...

# 4) 映像素材（Pexels 無料 API キー）
PEXELS_API_KEY=...

# 任意: 即時公開せず下書き(private)で止めたいとき true
DRY_RUN=false
