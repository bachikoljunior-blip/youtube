# ---------------------------------------------------------------------------
# ローカル実行用。GitHub Actions では同じ名前で Repository secrets に登録する。
# 本番の値を .env に入れてもコミットされない（.gitignore 済み）
#
# 必須は4つ。5つ目は入れると音声の質が上がる（無くても動く）。
# ANTHROPIC_API_KEY は使わない。設定されていても実行時に無視する。
# ---------------------------------------------------------------------------

# 1) 台本生成（サブスク認証。手元で `claude setup-token` を実行して取得）
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# 2) YouTube（OAuth 2.0 Playground で取得。docs/SETUP.md 参照）
YT_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
YT_CLIENT_SECRET=GOCSPX-...
YT_REFRESH_TOKEN=1//0e...

# 3) 任意: 音声合成の質を上げる。未設定なら open-jtalk（無料・鍵不要）になる
GOOGLE_TTS_API_KEY=

# 任意: 投稿せず生成だけ試す
DRY_RUN=false
