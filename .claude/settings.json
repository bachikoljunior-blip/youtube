{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/goal_reminder.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/goal_reminder.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "BashOutput",
      "KillBash",
      "Monitor",
      "TodoWrite",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pip *)",
      "Bash(bash scripts/*)",
      "Bash(ffmpeg *)",
      "Bash(ffprobe *)",
      "Bash(git *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(date *)",
      "Bash(echo *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(jq *)",
      "Bash(rm -rf build/*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(env)",
      "Bash(printenv*)",
      "Bash(sudo *)"
    ]
  }
}
