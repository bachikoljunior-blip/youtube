{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/policy_pause.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash scripts/env_guard.sh",
            "timeout": 300
          },
          {
            "type": "command",
            "command": "bash scripts/ahead_sweep.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/policy_pause.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash scripts/goal_reminder.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/policy_pause.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash scripts/goal_reminder.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/stop_check.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "BashOutput",
      "KillBash",
      "Monitor",
      "TodoWrite",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pip *)",
      "Bash(bash scripts/*)",
      "Bash(ffmpeg *)",
      "Bash(ffprobe *)",
      "Bash(git *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(date *)",
      "Bash(echo *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(jq *)",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a",
      "mcp__Claude_Code_Remote",
      "mcp__github",
      "Bash(rm -rf build/*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(env)",
      "Bash(printenv*)",
      "Bash(sudo *)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 scripts/statusline_usage.py",
    "padding": 0
  }
}
